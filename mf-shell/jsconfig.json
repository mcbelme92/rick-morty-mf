{
  "compilerOptions": {
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],

      "@app/*": ["./src/app/*"],

      "@components/*": ["./src/components/*"],
      "@ui/*": ["./src/components/UI/*"],

      "@features/*": ["./src/features/*"],

      "@data/*": ["./src/data/*"],

      "@styles/*": ["./src/styles/*"]
    }
  },
  "include": ["src"]
}
